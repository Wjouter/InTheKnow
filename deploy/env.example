# InTheKnow settings (DEPLOY.md § Settings).
# Copy this file to .env next to compose.yaml, then: chmod 600 .env
# One NAME=value per line. Wrap a value in single quotes if it contains $, #, a space or a quote: SMTP_PASSWORD='pa$s #1'
# Upgrades never change this file.

# --- Required: the stack refuses to start while any of these is empty ---

# The public address, origin only: https, the host and an optional port. No path, no trailing /, no query, no fragment.
# Example: https://intheknow.example.nl
PUBLIC_URL=

# Database password. Generate one with: openssl rand -hex 32
# It is read only when the database volume is first created; DEPLOY.md § Settings says how to change it later.
POSTGRES_PASSWORD=

# SMTP server (STARTTLS). Example: smtp.example.nl
SMTP_HOST=

# Sender address of every email. Example: intheknow@example.nl
SMTP_FROM=

# --- Optional, shown with their defaults ---

#SMTP_PORT=587
# Set these two together:
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Host ports on 127.0.0.1 that your reverse proxy forwards to:
#WEB_PORT=3000
#API_PORT=5000
# Change only if `up` reports that the pool overlaps:
#STACK_SUBNET=172.30.250.0/24

# --- Any other API setting, under its environment name ---

#InTheKnow__CheckInterval=00:10:00
#InTheKnow__Notifications__DefaultTimeZone=Europe/Amsterdam
#InTheKnow__Accounts__BotCheck__Provider=turnstile
#InTheKnow__Accounts__BotCheck__SiteKey=
#InTheKnow__Accounts__BotCheck__SecretKey=
#InTheKnow__MyTimetables__Domains__0__Host=mytimetables.inholland.nl
# Every other key: https://github.com/Wjouter/InTheKnow/blob/main/specs/001-ical-change-detection/contracts/configuration.md
#   https://github.com/Wjouter/InTheKnow/blob/main/specs/003-notification-channels/contracts/configuration.md
#   https://github.com/Wjouter/InTheKnow/blob/main/specs/004-accounts-login/contracts/configuration.md

# --- Set by the stack: setting them here has no effect (use the named settings above) ---
# ConnectionStrings__Default, PGPASSWORD, ASPNETCORE_HTTP_PORTS, InTheKnow__Accounts__TrustedProxies__0..2,
# InTheKnow__Notifications__PublicBaseUrl, InTheKnow__Notifications__FrontendBaseUrl,
# InTheKnow__Notifications__Email__Host, __Port, __Username, __Password, __FromAddress
